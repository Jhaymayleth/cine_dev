# Copia este archivo como .env.local y completa los valores
# La información sensible nunca se sube al repositorio

# Nombre de la aplicación
NEXT_PUBLIC_APP_NAME=Multicine

# URL base de la API (Postman Mock Server para desarrollo)
NEXT_PUBLIC_API_URL=https://33dfb5ad-947a-4c04-a41b-eb42ed5ee8f5.mock.pstmn.io

# Tiempo máximo de espera de las peticiones (milisegundos)
NEXT_PUBLIC_API_TIMEOUT=10000

# Entorno de ejecución (development | production)
NEXT_PUBLIC_APP_ENV=development

# Claves públicas de servicios externos
NEXT_PUBLIC_PUBLIC_KEY=

